{
  "appId": "fr.casteria.launcher",
  "productName": "Casteria",
  "copyright": "Casteria",
  "directories": {
    "output": "plateformes/linux/sortie"
  },
  "files": [
    "amorce/**/*",
    "electron/**/*",
    "src/**/*",
    "package.json",
    "!electron/fenetre/CONTRAT_FENETRE.md",
    "!electron/icones/logo-*.png"
  ],
  "extraResources": [
    {
      "from": "bin/LICENSE-portablemc.txt",
      "to": "bin/LICENSE-portablemc.txt"
    },
    {
      "from": "bin/empreintes.json",
      "to": "bin/empreintes.json"
    }
  ],
  "toolsets": {
    "appimage": "1.0.3"
  },
  "linux": {
    "target": [
      {
        "target": "dir",
        "arch": [
          "x64"
        ]
      }
    ],
    "executableName": "casteria",
    "icon": "plateformes/linux/icones",
    "category": "Game",
    "synopsis": "Casteria, un serveur Skyblock moddé : ton île, tes machines et des boss à affronter.",
    "description": "Casteria, un serveur Skyblock moddé : ton île, tes machines et des boss à affronter.",
    "maintainer": "Casteria",
    "extraResources": [
      {
        "from": "bin/linux-x64/portablemc",
        "to": "bin/portablemc"
      }
    ],
    "desktop": {
      "entry": {
        "Name": "Casteria",
        "Comment": "Casteria, un serveur Skyblock moddé : ton île, tes machines et des boss à affronter.",
        "Categories": "Game;",
        "StartupWMClass": "casteria",
        "Terminal": "false"
      }
    }
  },
  "appImage": {
    "artifactName": "Casteria-Linux-x86_64.AppImage"
  },
  "extraMetadata": {
    "homepage": "https://github.com/guerrinflorian/casteria-mc"
  },
  "deb": {
    "artifactName": "Casteria-Linux-x86_64.deb",
    "packageName": "casteria",
    "priority": "optional",
    "depends": [
      "libgtk-3-0t64 | libgtk-3-0",
      "libnss3",
      "libasound2t64 | libasound2",
      "libgbm1",
      "libatspi2.0-0t64 | libatspi2.0-0",
      "libnotify4",
      "libxss1",
      "libxtst6",
      "libuuid1",
      "libsecret-1-0",
      "xdg-utils"
    ]
  },
  "pacman": {
    "artifactName": "Casteria-Linux-x86_64.pacman",
    "packageName": "casteria",
    "depends": ["gtk3", "nss", "alsa-lib", "mesa", "libcups", "libxss", "libxtst", "libnotify", "libsecret", "xdg-utils"]
  }
}
